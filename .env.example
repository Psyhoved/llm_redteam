OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TARGET: тестируемая модель (Phase 1 и Phase 2)
OPENROUTER_MODEL=openrouter/inclusionai/ling-2.6-1t:free

# Phase 1-compatible aliases. Phase 2 can use these if OPENROUTER_MODEL/JUDGE_MODEL are not set.
# TARGET_MODEL=openai-api/myproxy/AlphaGaO/Qwen3-14B-GPTQ
# GRADER_MODEL=openrouter/inclusionai/ling-2.6-flash:free
# MYPROXY_BASE_URL=http://10.70.54.230:8008/v1
# MYPROXY_API_KEY=dummy
#
# Optional explicit Phase 2 endpoints/API key:
# TARGET_BASE_URL=https://openrouter.ai/api/v1
# TARGET_API_KEY=your_target_key_here
# ATTACKER_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_BASE_URL=https://openrouter.ai/api/v1

# ATTACKER: модель, генерирующая атакующие промпты (Phase 2, DeepTeam)
# Если не задано — используется значение OPENROUTER_MODEL
ATTACKER_MODEL=openai/gpt-4o-mini

# JUDGE: модель, оценивающая ответы тестируемой модели (Phase 2, DeepTeam)
# Если не задано — используется значение OPENROUTER_MODEL
JUDGE_MODEL=openai/gpt-4o-mini

# Число атак на каждую OWASP уязвимость (Phase 2)
# Итого тест-кейсов = ATTACKS_PER_TYPE × 7. Для проверки используй 1.
ATTACKS_PER_TYPE=5
MAX_CONCURRENT=10

# Optional: absolute path to datasets directory (default: relative ../../datasets from each lab)
# DATASETS_DIR=/absolute/path/to/phase1_inspect/datasets
